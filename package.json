{
  "name": "nexos-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "npm run check:foundations && npm run check:docs && npm test && npm run typecheck && npm run build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run check && wrangler deploy",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:foundations": "node scripts/check-foundations.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.48.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "postcss": "8.5.29",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  }
}
